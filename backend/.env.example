DATABASE_URL=sqlite:///./obs_ping.db
SECRET_KEY=change-this-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OTP — set OTP_DEBUG_EXPOSE=true locally to show codes in API responses
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_CHALLENGE_EXPIRE_MINUTES=15
OTP_DEBUG_EXPOSE=true
# Set false to skip email OTP on sign-in only (forgot-password OTP still applies)
LOGIN_OTP_ENABLED=true

# SMTP (optional; without SMTP, OTP codes are printed in the backend console)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=OBS PING <your@gmail.com>
# SMTP_USE_TLS=true
